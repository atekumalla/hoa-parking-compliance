# ============================================================
# REQUIRED
# ============================================================

# Google Sheets Configuration
# Get Sheet ID from the URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Drive Configuration
# Create a folder in a Shared Drive (service accounts have no personal storage
# quota), then give the service account Content Manager access. Get the Folder ID
# from the URL: https://drive.google.com/drive/folders/YOUR_FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Path to your Google Service Account JSON key file
# Download from Google Cloud Console > IAM & Admin > Service Accounts
# On Render this is set automatically by start.sh from GOOGLE_CREDENTIALS_JSON.
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json


# ============================================================
# OPTIONAL - Per-user photo uploads (Google OAuth)
# ============================================================
# When set, a "Sign in with Google" control appears in the app header and photo
# uploads are billed against each user's own Drive quota instead of the service
# account's. Create an OAuth 2.0 Client ID (Web application) under
# APIs & Services > Credentials, and register the redirect URI below.
# In production this must match your deployed URL exactly.

GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501


# ============================================================
# OPTIONAL - AI photo analysis
# ============================================================
# Enables the "Analyze with AI" button that auto-fills plate, make, and model.
# Get a key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=your_openai_api_key_here

# Vision model used for plate recognition (defaults to gpt-4o-mini).
# Options: gpt-4o-mini (cheapest, recommended), gpt-4o, gpt-4.1-nano, gpt-4.1-mini, gpt-4.1
# A stronger model reads difficult plates more reliably at higher cost per photo.
OPENAI_VISION_MODEL=gpt-4o-mini


# ============================================================
# OPTIONAL - Tuning & diagnostics
# ============================================================

# How many vehicles to show on the scoreboard (defaults to 20)
SCOREBOARD_TOP_N=20

# Set to 1 to log RSS and peak memory at key checkpoints. Useful for diagnosing
# out-of-memory restarts on small containers.
MEMORY_DEBUG=0
